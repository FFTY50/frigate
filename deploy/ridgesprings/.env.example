COMPOSE_PROJECT_NAME=retailrewind-ridgesprings

# Leave blank for local-only access. Set to "tunnel" after adding CLOUDFLARED_TOKEN.
COMPOSE_PROFILES=
CLOUDFLARED_TOKEN=

TZ=America/New_York
RETAIL_REWIND_IMAGE=retailrewind/frigate:current

RR_CONFIG_DIR=/opt/retailrewind/config
RR_MEDIA_DIR=/opt/retailrewind/media
RR_DB_DIR=/opt/retailrewind/db

FRIGATE_UI_PORT=8971
FRIGATE_INTERNAL_PORT=5000
FRIGATE_SHM_SIZE=4g

# Dell OptiPlex 3070 Intel iGPU. If VAAPI logs fail, try i965.
LIBVA_DRIVER_NAME=iHD
